# Runtime profile: sandbox | official
# Unset defaults to sandbox, the fast private-sandbox track.
SUMIRE_PROFILE=sandbox

# Directory containing game data (master data, decoded blobs, etc.).
# `npm run data:fetch` fills ./data. Never commit this directory.
SUMIRE_DATA_DIR=./data

# Static client wire-crypto constant. It is embedded in every game client, so it
# is the same for all users and is not a secret. `.env.example` ships it so a
# fresh clone can talk to the server without extra setup.
WIRE_SEC_KEY=AJRnFaOnOj

# RS256 JWT signing key. Generated on first boot if the file is missing.
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem

# PostgreSQL 18. The compose stack uses the same database name and user.
DATABASE_URL=postgres://idoly:idoly_dev_pw@localhost:5432/idoly

# HTTP listener. Port 8080 is what docker-compose publishes.
PORT=8080

# Local asset mirror (docs/ASSET_MIRROR.md): directory of already-extracted final
# artifacts (.opus/.png/.atlas/.json) served at GET /assets/*. Unset disables the
# route. Keep it under a git-ignored path; never commit its contents.
# SUMIRE_ASSET_MIRROR_DIR=./data/asset-mirror

# EXPERIMENTAL local Octo store (packages/server/src/octoStore.ts, docs/ASSET_MIRROR.md §0).
# Set SUMIRE_OCTO_DATABASE to serve a local decrypted Octo database plus MD5-named bundle
# files instead of proxying the list upstream. Unset = off. Key/IV: hex, never committed.
# SUMIRE_OCTO_DATABASE=
# SUMIRE_OCTO_ASSETS=
# SUMIRE_OCTO_AES_KEY=
# SUMIRE_OCTO_AES_IV=
# SUMIRE_OCTO_URL_FORMAT=https://api.octo-cloud.com/octo/{type}/{o}?v={v}&g={g}
# SUMIRE_OCTO_UPSTREAM_FILL=1

# SUMIRE_UNHANDLED_RPC: error (default): unknown RPCs reply gRPC 12 + a "not implemented" dialog; empty: legacy empty success body
SUMIRE_UNHANDLED_RPC=error

# Who may get an account: open | invite | closed. Do not leave this empty: the
# server refuses to start on any other value. See "Invite links" in the README.
SUMIRE_REGISTRATION=open

# Bearer token for the /sumire/admin/* routes, including creating invite links.
# Empty turns those routes off (they answer 404). Use a long random value, such
# as the output of `openssl rand -hex 32`, and never commit it.
SUMIRE_ADMIN_TOKEN=

# Base URL for invite links, with the port if it isn't the default for the scheme
# and no trailing slash, e.g. https://sumire.example:8443
# Empty uses https:// plus the host of the request that created the link.
SUMIRE_PUBLIC_URL=
